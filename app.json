{
  "expo": {
    "name": "STOCKASTICS",
    "slug": "stockastics",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "stockastics",
    "userInterfaceStyle": "light",
    "plugins": ["expo-router", "expo-notifications"],
    "experiments": {"typedRoutes": true},
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.stochastics.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#08183E"
      }
    },
    "ios": {"bundleIdentifier": "com.stochastics.mobile"},
    "web": {"bundler": "metro"}
  }
}
