{
  "expo": {
    "name": "STOCKASTICS",
    "slug": "stockastics",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "stockastics",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "backgroundColor": "#000000",
          "imageWidth": 250,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.stochastics.mobile"
    },
    "ios": {
      "bundleIdentifier": "com.stochastics.mobile"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
